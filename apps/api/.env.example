# Server
ENV=development
PORT=8080

# Postgres
DATABASE_URL=postgres://osama:osama@localhost:5432/osama?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (RS256) — generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt_private.pem
#   openssl rsa -pubout -in keys/jwt_private.pem -out keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ISSUER=osama-api

# Token TTLs (Go duration strings: 15m, 720h, etc.)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Cookies
# Leave COOKIE_DOMAIN empty to set host-only cookies (no Domain attribute).
# Required on platforms whose root domain is on the Public Suffix List
# (e.g. *.onrender.com, *.vercel.app), where browsers silently drop any
# Set-Cookie carrying a PSL-listed Domain. Set explicitly only when the
# API and the web app live on different subdomains of a shared parent
# domain that you own.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Rate limit (per user, per minute)
RATE_LIMIT_PER_MINUTE=100

# Optional: bootstrap admin on first boot (skipped if email already exists)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# CMS → Web revalidate webhook. Leave URL empty to disable.
# Must match NEXT_REVALIDATE_SECRET in apps/web/.env.local.
NEXT_REVALIDATE_URL=http://localhost:3000/api/revalidate
NEXT_REVALIDATE_SECRET=replace-me-with-a-long-random-string
