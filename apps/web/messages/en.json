        "programming": {
          "title": "Why training has to change every 4 weeks",
          "excerpt": "Periodisation isn't a buzzword. It's the difference between a plateau and steady progress.",
          "minutes": "4",
          "tag": "Training",
          "body": "Every 4 weeks, your muscles adapt to the stimulus. Running the same program at the same weights stalls you. Periodisation — varying volume and intensity each block — is what breaks the plateau."
        },
        "nutrition": {
          "title": "Macros vs Calories",
          "excerpt": "Protein, carbs, and fat each play a different role.",
          "minutes": "5",
          "tag": "Nutrition",
          "body": "Calories set your direction (gain or lose), but macros decide the kind of change. 2,000 kcal from high protein builds muscle; 2,000 kcal from carbs alone won't produce the same result."
        },
        "recovery": {
          "title": "Sleep is the second workout",
          "excerpt": "Seven hours minimum matters more than any supplement.",
          "minutes": "3",
          "tag": "Recovery",
          "body": "95% of muscle building happens while you sleep. Growth hormone, testosterone, and tissue repair all peak in deep-sleep stages. Any protocol without 7+ hours of sleep is an incomplete protocol."
        }
      }
    },
