# Server-only — the Next.js server proxies /api/* and /healthz to this
# upstream (see apps/web/next.config.mjs). The browser only ever talks to the
# Next.js origin, so auth cookies stay first-party.
API_INTERNAL_URL=http://localhost:8080

# Public — bundled into the client. Leave UNSET in production so browser
# fetches go same-origin through the rewrite. Set to a full URL only for local
# dev workflows that hit the Go API directly without running Next.js.
# NEXT_PUBLIC_API_URL=

# Server-only — used to authenticate the /api/revalidate webhook from the
# Go API. Must match NEXT_REVALIDATE_SECRET in apps/api/.env.
NEXT_REVALIDATE_SECRET=replace-me-with-a-long-random-string
